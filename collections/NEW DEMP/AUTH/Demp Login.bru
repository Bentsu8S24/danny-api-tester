  {
    "username": "aunyaman",
    "password": "aunyaman@today",
    "is_remember": true,
    "is_vekin_login": true
  }
}

script:post-response {
  const rawCookie = res.getHeader('set-cookie');
  
  if (rawCookie) {
    // แปลงเป็น String ในกรณีที่เป็น Array
    const cookieStr = Array.isArray(rawCookie) ? rawCookie.join('; ') : rawCookie;
  
    // ใช้ Regular Expression เพื่อดึงเฉพาะ Key=Value ของ csrftoken และ sessionid
    const csrfMatch = cookieStr.match(/csrftoken=([^;]+)/);
    const sessionMatch = cookieStr.match(/sessionid=([^;]+)/);
  
    let finalCookie = "";
  
    if (csrfMatch) finalCookie += csrfMatch[0];
    if (sessionMatch) {
      if (finalCookie) finalCookie += "; ";
      finalCookie += sessionMatch[0];
    }
  
    // เก็บลงใน Variable ชื่อ 'my_auth_cookie'
    if (finalCookie) {
      bru.setVar("MY_AUTH_COOKIE", finalCookie);
      console.log("Saved Cookie:", finalCookie);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
